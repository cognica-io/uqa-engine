# Licensing files are copied verbatim into every published package and are
# verified byte for byte against the canonical copies at release time.
#
# Git converts text files to CRLF on Windows checkouts by default, so a wheel
# built on a Windows runner embedded a CRLF LICENSE while the same file on
# Linux was LF. The per-platform check could not see it, because on Windows
# both the wheel's copy and the canonical file it was compared against had been
# converted; only the final check before publication caught the mismatch.
#
# Pinning these paths to LF keeps the published copies identical on every
# platform. The patterns carry no slash, so they also match the mirrored copies
# under crates/.
LICENSE                             text eol=lf
LICENSE-NOTICE.md                   text eol=lf
LICENSING.md                        text eol=lf
UQA-FOSS-EXCEPTION-1.0.txt          text eol=lf
UQA-NONCOMMERCIAL-EXCEPTION-1.0.txt text eol=lf

# Imported PostgreSQL 18 parser snapshot. Preserve upstream bytes exactly;
# SHA256SUMS, rather than Git's whitespace heuristic, verifies this tree.
crates/uqa-pg-query/libpg_query/** -whitespace linguist-vendored
crates/uqa-pg-query/src/protobuf.rs linguist-generated
crates/uqa-pg-query/src/node_enum.rs linguist-generated
crates/uqa-pg-query/src/node_mut.rs linguist-generated
crates/uqa-pg-query/src/node_ref.rs linguist-generated
crates/uqa-pg-query/src/node_structs.rs linguist-generated

# Imported morphology dictionaries and notices retain their exact upstream contents.
# The resource manifest verifies their hashes across platforms.
crates/uqa-nori-data/data/nori.uqan binary
crates/uqa-nori-data/data/*.json text eol=lf linguist-generated
crates/uqa-nori-data/THIRD-PARTY/** -text -whitespace linguist-vendored
crates/uqa-kuromoji-data/data/kuromoji.uqak binary
crates/uqa-kuromoji-data/data/*.json text eol=lf linguist-generated
crates/uqa-kuromoji-data/THIRD-PARTY/** -text -whitespace linguist-vendored
crates/uqa-analysis/THIRD-PARTY/LUCENE-*.txt -text -whitespace linguist-vendored
crates/uqa-analysis/THIRD-PARTY/LUCENE-SOURCE.md text eol=lf
# Binding copies are checked against the same canonical resource inventory.
crates/uqa-node/THIRD-PARTY/** -text -whitespace linguist-vendored
crates/uqa-wasm/js/THIRD-PARTY/** -text -whitespace linguist-vendored
python/uqa/THIRD-PARTY/** -text -whitespace linguist-vendored

# Nori contract and fixture identities hash the exact checked-out bytes.
crates/uqa-analysis/benches/nori/corpus.json text eol=lf
crates/uqa/benches/nori_sql/catalogs/*.db binary
crates/uqa/benches/nori_sql/catalogs/*.json text eol=lf
tests/parity/nori/**/*.json text eol=lf
tests/parity/nori/**/*.jsonl text eol=lf
tests/parity/kuromoji/**/*.json text eol=lf
tests/parity/kuromoji/**/*.jsonl text eol=lf
benchmarks/nori/**/*.json text eol=lf
benchmarks/nori/**/*.jsonl text eol=lf

# Reference-oracle fixtures are generated from pinned inputs.
tests/parity/nori/*_expected.jsonl linguist-generated
