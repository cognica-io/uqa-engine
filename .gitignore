# Cargo build output
/target
**/target/

# Python build and cache output
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
build/
# Rust modules under crate source trees are not Python build output.
!crates/*/src/**/build/
dist/
*.egg-info/
*.whl
/python/uqa/_uqa*.so
/python/uqa/_uqa*.pyd

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Rust analyzer
rust-project.json

# Profiling
/output/playwright/
perf.data
perf.data.old
flamegraph.svg

# Local environment
.env
.env.local

# Generated docs (we publish via cargo doc, not committed)
/target/doc/

# Claude Code workspace metadata is local, except for shared project skills.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/uqa-engine

# emscripten build outputs copied into the WASM npm package
crates/uqa-wasm/js/uqa.js
crates/uqa-wasm/js/uqa.wasm

# napi build outputs
crates/uqa-node/*.node
crates/uqa-node/node_modules/

# Generated Nori measurements belong in target/benchmark-runs or CI artifacts.
/benchmarks/nori/evidence/
/benchmarks/nori/*-evidence/
/benchmarks/nori/*followup-evidence.json

# Native transaction and snapshot coordination
*.uqa-snapshots
*.uqa-serializable
*.uqa-serializable-journal
*.uqa-serializable-leases
