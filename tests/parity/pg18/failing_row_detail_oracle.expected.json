    {
      "sql": "CREATE FUNCTION fr_trigger_store() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $$ BEGIN IF TG_OP = 'INSERT' THEN IF NEW.id >= 50 THEN NEW.v := abs(NEW.v); END IF; INSERT INTO fr_stored VALUES (NEW.id, NEW.v, coalesce(NEW.note, 'trig')); RETURN NEW; END IF; UPDATE fr_stored SET v = NEW.v WHERE id = OLD.id; RETURN NEW; END $$",
      "command_tags": [
        "CREATE FUNCTION"
      ],
      "error": null,
