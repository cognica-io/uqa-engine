@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/UQATargets.cmake")
if(NOT TARGET UQA::uqa_static)
  set(_uqa_bundled_names "@UQA_BUNDLED_NATIVE_NAMES@")
  set(_uqa_original_libraries "@UQA_NATIVE_LIBRARIES@")
  set(_uqa_native_libraries)
  foreach(_uqa_library IN LISTS _uqa_original_libraries)
    if(_uqa_library IN_LIST _uqa_bundled_names)
      list(APPEND _uqa_native_libraries "@PACKAGE_CMAKE_INSTALL_LIBDIR@/${_uqa_library}")
    else()
      list(APPEND _uqa_native_libraries "${_uqa_library}")
    endif()
  endforeach()
  add_library(UQA::uqa_static STATIC IMPORTED)
  set_target_properties(UQA::uqa_static PROPERTIES
    IMPORTED_LOCATION "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@UQA_STATIC_FILENAME@"
    INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES "${_uqa_native_libraries}"
    INTERFACE_LINK_OPTIONS "@UQA_NATIVE_LINK_OPTIONS@")
  unset(_uqa_bundled_names)
  unset(_uqa_original_libraries)
  unset(_uqa_native_libraries)
  unset(_uqa_library)
endif()
check_required_components(UQA)
