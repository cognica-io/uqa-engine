      "sql": "CREATE FUNCTION record_change(mode integer, v text) RETURNS text LANGUAGE plpgsql AS $$ DECLARE r record; n bigint; BEGIN IF mode = 0 THEN INSERT INTO query_records VALUES (1,v) RETURNING value INTO r; ELSIF mode = 1 THEN UPDATE query_records SET value = v WHERE id = 1 RETURNING value INTO r; ELSE DELETE FROM query_records WHERE id = 1 RETURNING value INTO r; END IF; GET DIAGNOSTICS n = ROW_COUNT; RETURN pg_collation_for(r.value) || ':' || coalesce(r.value,'NULL') || ':' || n::text || ':' || FOUND::text; END $$",
