      "sql": "CREATE FUNCTION record_fields() RETURNS trigger LANGUAGE plpgsql AS $$DECLARE r record; old_coll oid; BEGIN IF TG_OP = 'UPDATE' THEN old_coll := pg_collation_for(OLD.c)::regcollation::oid; END IF; r := NEW; INSERT INTO observations VALUES (TG_OP, pg_collation_for(NEW.c)::regcollation::oid, pg_collation_for(NEW.p)::regcollation::oid, pg_collation_for(NEW.plain)::regcollation::oid, pg_collation_for(r.c)::regcollation::oid, old_coll, r.c); RETURN NEW; END$$",
