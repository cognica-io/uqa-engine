    "CREATE SEQUENCE endpoint_calls",
    "CREATE SEQUENCE canonical_calls",
    "CREATE FUNCTION check_endpoint(x integer) RETURNS boolean LANGUAGE plpgsql AS $$ BEGIN PERFORM nextval('endpoint_calls'); RETURN x > 0; END $$",
    "CREATE DOMAIN positive AS integer NOT NULL CHECK (check_endpoint(VALUE))",
    "CREATE TYPE r AS RANGE (subtype=integer,multirange_type_name=rs)",
    "CREATE TYPE dr AS RANGE (subtype=positive,multirange_type_name=drs)",
    "CREATE TYPE tr AS RANGE (subtype=text,collation=\"C\",multirange_type_name=trs)",
    "CREATE TYPE ur AS RANGE (subtype=text,collation=\"pg_catalog\".\"unicode\",multirange_type_name=urs)",
    "CREATE TYPE ar AS RANGE (subtype=integer[],multirange_type_name=ars)",
    "CREATE TYPE label AS ENUM ('early','late')",
    "CREATE TYPE er AS RANGE (subtype=label,multirange_type_name=ers)",
    "CREATE TYPE cr",
    "CREATE FUNCTION canon(cr) RETURNS cr LANGUAGE internal IMMUTABLE AS 'int4range_canonical'",
    "CREATE TYPE cr AS RANGE (subtype=integer,canonical=canon,multirange_type_name=crs)",
    "CREATE OR REPLACE FUNCTION canon(cr) RETURNS cr LANGUAGE plpgsql AS $$ BEGIN PERFORM nextval('canonical_calls'); RETURN $1; END $$",
    "CREATE FUNCTION reference_eval(statement text) RETURNS jsonb LANGUAGE plpgsql AS $$ DECLARE output text; code text; message text; detail text; hint text; answer jsonb; BEGIN ALTER SEQUENCE endpoint_calls RESTART; ALTER SEQUENCE canonical_calls RESTART; BEGIN EXECUTE statement INTO output; answer := jsonb_build_object('output',output); EXCEPTION WHEN OTHERS THEN GET STACKED DIAGNOSTICS code=RETURNED_SQLSTATE,message=MESSAGE_TEXT,detail=PG_EXCEPTION_DETAIL,hint=PG_EXCEPTION_HINT; answer := jsonb_build_object('error',jsonb_build_object('sqlstate',code,'message',message,'detail',detail,'hint',hint)); END; RETURN answer || jsonb_build_object('endpoint_calls',(SELECT CASE WHEN is_called THEN last_value ELSE 0 END FROM endpoint_calls),'canonical_calls',(SELECT CASE WHEN is_called THEN last_value ELSE 0 END FROM canonical_calls)); END $$"
